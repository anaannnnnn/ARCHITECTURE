# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-string

# --- Database (SQLite file, created automatically) ---
DATABASE_PATH=./src/db/archive.sqlite

# --- Google Drive (used as file storage for downloadable assets) ---
# 1. Go to console.cloud.google.com -> create a project
# 2. Enable "Google Drive API"
# 3. Create a Service Account, download its JSON key
# 4. Share your target Drive folder with the service account's email
#    (found inside the JSON key as "client_email")
#
# LOCAL DEV: put the downloaded key file at the path below (do NOT commit it)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./src/config/google-service-account.json
#
# RENDER / PRODUCTION: instead of a file, paste the ENTIRE JSON key content
# as a single-line env var in Render's dashboard (Environment tab). When set,
# this takes priority over GOOGLE_SERVICE_ACCOUNT_KEY_PATH.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
GOOGLE_SERVICE_ACCOUNT_JSON=

GOOGLE_DRIVE_ROOT_FOLDER_ID=paste-the-drive-folder-id-here

# --- External open APIs used for case study / image aggregation ---
EUROPEANA_API_KEY=
GETTY_API_BASE=https://data.getty.edu/museum/collection
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIMEDIA_COMMONS_API=https://commons.wikimedia.org/w/api.php
